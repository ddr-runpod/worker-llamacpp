# =============================================================================
# llama.cpp Worker Configuration
# Optimized for: RTX 5090 (32GB VRAM) + Gemma 4 26B A4B (UD-Q6_K_XL)
# Use case: Chat + Agentic mode
# =============================================================================

# -----------------------------------------------------------------------------
# Model Configuration (Required - choose one)
# -----------------------------------------------------------------------------
#
# Option A: RunPod Model Caching (Recommended for production)
#   Set the "Model" field in the RunPod console to the HuggingFace repo ID.
#   These paths auto-resolve to the correct snapshot via refs/main.
#
LLAMA_MODEL_RUNPOD_CACHE=philipsorst/gemma-4-26B-A4B-it-UD-Q6_K_XL/gemma-4-26B-A4B-it-UD-Q6_K_XL.gguf
LLAMA_MMPROJ_RUNPOD_CACHE=philipsorst/gemma-4-26B-A4B-it-UD-Q6_K_XL/mmproj-BF16.gguf

# Option B: HuggingFace Auto-Download (Convenient for development/testing)
#   Llama-server downloads the model automatically on first request.
#   LLAMA_HF_MODEL=philipsorst/gemma-4-26B-A4B-it-UD-Q6_K_XL

# -----------------------------------------------------------------------------
# HuggingFace Cache (Optional - defaults to RunPod cache directory)
# -----------------------------------------------------------------------------

# Directory for HuggingFace model cache. Defaults to /runpod-volume/huggingface-cache
# which is the RunPod network volume path. Uncomment to override:
# HF_HOME=/runpod-volume/huggingface-cache

# HuggingFace access token (required for gated models like Llama 4, etc.)
# Leave empty if not needed
HF_TOKEN=

# -----------------------------------------------------------------------------
# Runtime Configuration
# -----------------------------------------------------------------------------

# Port for the FastAPI app (set automatically by RunPod)
# Defaults to 80 if not set
PORT=80

# -----------------------------------------------------------------------------
# Sampling Configuration
# -----------------------------------------------------------------------------

# Context window size (in tokens)
# Maximum: Model supports 256K, but 32K+ uses significant VRAM for KV cache
# Recommended:
#   - 8192:  Fastest, minimal VRAM overhead
#   - 16384: Good balance for chat/agentic (default)
#   - 32768: Large context, more VRAM usage - may need to reduce batch size
LLAMA_CONTEXT_SIZE=32768

# Number of model layers to offload to GPU
# 99 (or -1, or any value >= model layers) = full GPU offload
# For Gemma 4 26B A4B: 30 layers total
# Full offload maximizes inference speed (10-50x faster than CPU)
LLAMA_N_GPU_LAYERS=99

# Sampling temperature (0.0 - 2.0)
# Controls randomness in output generation
# Recommended:
#   - 0.1-0.3: Very deterministic, best for tool calling / code
#   - 0.6-0.7: Good balance for chat + agentic reasoning (default)
#   - 0.8-1.0: More creative/varied output
LLAMA_TEMPERATURE=0.6

# Top-p sampling (nucleus sampling, 0.0 - 1.0)
# Limits token selection to cumulative probability threshold
# Lower = more restrictive, higher = more diverse
# 0.95 is standard for chat applications
LLAMA_TOP_P=0.95

# Top-k sampling
# Limits token selection to top k most likely tokens
# 64 is standard; lower values = more focused output
LLAMA_TOP_K=64

# Number of parallel request slots
# 1 = single request at a time (recommended for serverless)
# Higher values increase throughput but use more VRAM
LLAMA_N_PARALLEL=1

# -----------------------------------------------------------------------------
# Reasoning Configuration
# -----------------------------------------------------------------------------

# Enable/disable reasoning mode for supported models
# Accepted values: on, 1, yes, off, 0, no (case-insensitive)
LLAMA_REASONING=on

# -----------------------------------------------------------------------------
# Batch Size & Attention (Optional)
# -----------------------------------------------------------------------------

# Flash Attention. Accepted values: on, 1, yes, off, 0, no (case-insensitive)
# Upstream default is "auto" - leave unset to use that.
LLAMA_FLASH_ATTN=on

# Logical maximum batch size for prompt processing (-b).
# Upstream default: 2048. Lower this if you hit OOM with large contexts.
LLAMA_BATCH_SIZE=512

# Physical (unbatched) maximum batch size for generation (-ub).
# Upstream default: 512. Lower this if you hit OOM with large contexts.
LLAMA_UBATCH_SIZE=512

# -----------------------------------------------------------------------------
# Speculative Decoding (Optional - Gemma 4 MTP)
# -----------------------------------------------------------------------------
# MTP enables 1.4-2.2x faster inference without accuracy loss.
# The "Model" field in the RunPod console must be set to the Gemma 4 repo ID.
LLAMA_SPEC_DRAFT_MODEL_RUNPOD_CACHE=philipsorst/gemma-4-26B-A4B-it-UD-Q6_K_XL/mtp-gemma-4-26B-A4B-it.gguf
LLAMA_SPEC_TYPE=draft-mtp
LLAMA_SPEC_DRAFT_N_MAX=2

# -----------------------------------------------------------------------------
# Advanced Options
# -----------------------------------------------------------------------------

# CPU threads (uncomment to override)
# Default: auto-detected. Lower values when using GPU offload.
# LLAMA_THREADS=8

# Additional llama-server command-line arguments
# Format: space-separated flags, use quotes for args with spaces
#
# Continuous batching (--cont-batching) is enabled by default upstream and
# intentionally not exposed as an env var.
LLAMA_EXTRA_ARGS=""
